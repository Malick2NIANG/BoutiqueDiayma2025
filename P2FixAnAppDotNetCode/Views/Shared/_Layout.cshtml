@using System.Globalization
@{
    string langue = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@langue">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – Boutique Diayma</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
</head>
<body>
    <a class="skip-link" href="#contenu">@Localizer["SkipToContent"]</a>

    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Product" asp-action="Index">
                <i class="fa fa-shopping-bag" aria-hidden="true"></i>
                <span>Boutique Diayma</span>
            </a>
            <nav class="main-nav" aria-label="@Localizer["MainMenu"]">
                <a asp-controller="Product" asp-action="Index">@Localizer["Products"]</a>
                @await Component.InvokeAsync("CartSummary")
                @await Component.InvokeAsync("LanguageSelector")
            </nav>
        </div>
    </header>

    <main id="contenu" class="container page">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p>&copy; 2026 Boutique Diayma</p>
        </div>
    </footer>

    <script>
        // Demande une confirmation avant les actions destructrices (formulaires portant data-confirm)
        // Ferme le menu des langues quand on clique ailleurs ou qu'on appuie sur Échap
        document.addEventListener('click', function (e) {
            document.querySelectorAll('details.lang-menu[open]').forEach(function (menu) {
                if (!menu.contains(e.target)) { menu.removeAttribute('open'); }
            });
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('details.lang-menu[open]').forEach(function (menu) { menu.removeAttribute('open'); });
            }
        });
        document.addEventListener('submit', function (e) {
            var message = e.target.getAttribute('data-confirm');
            if (message && !window.confirm(message)) {
                e.preventDefault();
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

@using System.Globalization
@model P2FixAnAppDotNetCode.Models.ViewModels.LanguageViewModel
@{
    string langue = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    // { valeur envoyée au contrôleur, code de culture, nom de la langue dans cette langue }
    var langues = new[]
    {
        new[] { "French", "fr", "Français" },
        new[] { "English", "en", "English" },
        new[] { "Wolof", "wo", "Wolof" },
        new[] { "Spanish", "es", "Español" }
    };
}
<form class="lang-form" asp-controller="Language" asp-action="ChangeUiLanguage" method="post">
    <label for="choix-langue"><i class="fa fa-globe" aria-hidden="true"></i> @Localizer["Language"]</label>
    <select id="choix-langue" name="Language">
        @foreach (var l in langues)
        {
            if (l[1] == langue)
            {
                <option value="@l[0]" lang="@l[1]" selected>@l[2]</option>
            }
            else
            {
                <option value="@l[0]" lang="@l[1]">@l[2]</option>
            }
        }
    </select>
    <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.Path" />
    <button type="submit" class="btn btn-light">@Localizer["Apply"]</button>
</form>

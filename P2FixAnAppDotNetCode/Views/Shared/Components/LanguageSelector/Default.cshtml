@using System.Globalization
@model P2FixAnAppDotNetCode.Models.ViewModels.LanguageViewModel
@{
    string langue = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    // { valeur envoyée au contrôleur, code de culture, nom de la langue, code affiché }
    var langues = new[]
    {
        new[] { "French", "fr", "Français", "FR" },
        new[] { "English", "en", "English", "EN" },
        new[] { "Wolof", "wo", "Wolof", "WO" },
        new[] { "Spanish", "es", "Español", "ES" }
    };
    var courante = langues.FirstOrDefault(l => l[1] == langue) ?? langues[1];
}
<form class="lang-form" asp-controller="Language" asp-action="ChangeUiLanguage" method="post">
    <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.Path" />
    <details class="lang-menu">
        <summary title="@Localizer["Language"] : @courante[2]" aria-label="@Localizer["Language"] : @courante[2]">
            <img class="flag" src="/images/flags/@(courante[1]).svg" alt="" />
            <span>@courante[3]</span>
            <i class="fa fa-caret-down" aria-hidden="true"></i>
        </summary>
        <ul class="lang-list">
            @foreach (var l in langues)
            {
                <li>
                    <button type="submit" name="Language" value="@l[0]" lang="@l[1]" title="@l[2]" aria-label="@l[2]" class="@(l[1] == courante[1] ? "active" : null)">
                        <img class="flag" src="/images/flags/@(l[1]).svg" alt="" />
                        <span>@l[3]</span>
                    </button>
                </li>
            }
        </ul>
    </details>
</form>

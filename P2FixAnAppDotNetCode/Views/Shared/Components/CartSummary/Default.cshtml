@model P2FixAnAppDotNetCode.Models.Cart
@{
    int nbArticles = Model.Lines.Sum(x => x.Quantity);
}
<a class="cart-link" asp-controller="Cart" asp-action="Index" title="@Localizer["OpenCart"]">
    <i class="fa fa-shopping-cart" aria-hidden="true"></i>
    <span>@Localizer["Cart"]</span>
    <span class="cart-count" aria-label="@Localizer["ItemsCount", nbArticles]">@nbArticles</span>
    @if (nbArticles > 0)
    {
        <span class="cart-total">@Model.GetTotalValue().ToString("N0") FCFA</span>
    }
</a>
